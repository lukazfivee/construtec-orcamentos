{
  "name": "construtec-orcamentos-cloud",
  "main": "index.js",
  "compatibility_date": "2026-09-15",
  "workers_dev": true,
  "triggers": { "crons": ["0 * * * *"] },
  "assets": {
    "directory": "../../dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/health"]
  },
  "containers": [{
    "class_name": "OrcamentosApi",
    "image": "../../Dockerfile",
    "instance_type": "basic",
    "max_instances": 1
  }],
  "durable_objects": { "bindings": [{ "name": "API", "class_name": "OrcamentosApi" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["OrcamentosApi"] }]
}
