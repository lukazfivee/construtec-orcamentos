{
  "name": "construtec-orcamentos",
  "productName": "Construtec Orçamentos",
  "version": "1.0.5",
  "description": "Orçamentos profissionais, rápidos, seguros e offline para a Construtec Engenharia.",
  "main": ".vite/build/main.js",
  "private": true,
  "scripts": {
    "start": "electron-forge start",
    "dev": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/dev.ps1",
    "dev:web": "node scripts/start-web.mjs",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "make:windows": "electron-forge make --platform=win32 --arch=x64",
    "installer:windows": "node scripts/build-installer.mjs",
    "publish": "electron-forge publish",
    "lint": "eslint --ext .ts,.tsx .",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm run lint && npm run test:critical",
    "security:audit": "npm audit --audit-level=high",
    "security:audit:prod": "npm audit --omit=dev --audit-level=high",
    "deploy:cloud": "node scripts/deploy-cloud.mjs",
    "deploy:cloud:dry": "node scripts/deploy-cloud.mjs --dry-run",
    "deploy:cloud:skipbuild": "node scripts/deploy-cloud.mjs --skip-build",
    "test:critical": "node scripts/test-critical.mjs"
  },
  "keywords": [
    "electron",
    "orcamentos",
    "local-first"
  ],
  "author": "Construtec Engenharia",
  "license": "UNLICENSED",
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-deb": "^7.11.2",
    "@electron-forge/maker-rpm": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.2",
    "@electron-forge/plugin-fuses": "^7.11.2",
    "@electron-forge/plugin-vite": "^7.11.2",
    "@electron/fuses": "^2.1.3",
    "@types/electron-squirrel-startup": "^1.0.2",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "44.4.0",
    "esbuild": "0.28.2",
    "eslint": "^10.10.0",
    "eslint-plugin-import": "^2.32.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.3.10",
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "bcryptjs": "^3.0.2",
    "docx": "^9.7.1",
    "electron-squirrel-startup": "^1.0.1",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.541.0",
    "pg": "^8.23.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.1.5"
  }
}
